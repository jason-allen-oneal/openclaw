{
  "argv": [
    "node",
    "scripts/run-vitest.mjs",
    "run",
    "--config",
    "test/vitest/vitest.e2e.config.ts",
    "test/e2e/qa-lab/runtime/vision-provider-identity.e2e.test.ts",
    "--maxWorkers=1",
    "-t",
    "native final.*false|legacy final.*true"
  ],
  "cwd": "<isolated-baseline>",
  "envOverrides": {
    "OPENCLAW_BUILD_PRIVATE_QA": "1",
    "OPENCLAW_E2E_USE_PREBUILT_DIST": "1",
    "IMAGE_IDENTITY_PROOF_RECEIPTS": "<proof-logs>/baseline-e2e-observations.jsonl",
    "OPENCLAW_VITEST_FS_MODULE_CACHE_PATH": "<proof-logs>/baseline-vitest-fs-cache"
  },
  "processUmask": "0077",
  "separateProcessSession": true,
  "exit": 1,
  "seconds": 160.2
}
